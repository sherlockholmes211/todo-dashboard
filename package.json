{
  "name": "todo-dashboard",
  "version": "1.1.0",
  "description": "A fast, scriptable terminal dashboard for tasks and concurrent timers",
  "repository": {
    "type": "git",
    "url": "https://github.com/sherlockholmes211/todo-dashboard.git"
  },
  "type": "module",
  "bin": {
    "todo": "dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0"
  },
  "keywords": [
    "todo",
    "tasks",
    "timer",
    "terminal",
    "tui"
  ],
  "license": "MIT",
  "dependencies": {
    "chrono-node": "2.8.0",
    "commander": "13.1.0",
    "env-paths": "3.0.0",
    "ink": "6.0.1",
    "react": "19.1.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "eslint": "9.39.5",
    "globals": "16.0.0",
    "ink-testing-library": "4.0.0",
    "typescript": "5.8.2",
    "typescript-eslint": "8.26.0",
    "vitest": "5.0.1"
  }
}
